# Environment variables read by the backend (set them in your shell or in Railway > Variables).
# Never commit real values. Full reference: HANDOVER.md §5.

# --- core ---
# development | staging | production. production refuses to start with unsafe settings (see HANDOVER.md §5).
APP_ENV=development
# Railway injects DATABASE_URL automatically when a PostgreSQL service is referenced.
DATABASE_URL=sqlite:///./mgm_dev.db
PUBLIC_APP_URL=http://localhost:8000
# Signs ticket QR codes and customer booking links (HMAC-SHA256). >= 32 random characters in staging/production.
# Rotating it invalidates every issued QR code and booking link.
APP_SECRET=
# Demo payment provider (no money moves). Must be 0 in production until a verified gateway is integrated.
SIMULATED_PAYMENTS=1
# Pins the park's "today" (YYYY-MM-DD) for demos only. Never set in production.
DEMO_TODAY=

# --- staff access ---
# Break-glass / automation credential acting as "admin" (header X-Admin-Token). Leave empty once real admin
# accounts exist; a short or placeholder value disables it.
ADMIN_API_TOKEN=

# --- influencer & regional intelligence ---
ATTRIBUTION_MODEL=first_click
ATTRIBUTION_WINDOW_DAYS=30
# Max influencer-attributed bookings per visitor session (anti-replay); further bookings are recorded without commission.
MAX_BOOKINGS_PER_SESSION=5
# Lifetime of an anonymous visitor session (all visitors).
VISITOR_SESSION_DAYS=30
COMMISSION_BASIS=ticket_net_ex_gst
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
TRUSTED_PROXY_HOPS=1

# --- web ---
# Only if the front-end is served from another origin (comma-separated).
CORS_ORIGINS=
FRONTEND_DIST=../dist
